# Gmail account used to send contact form emails (the sender account)
GMAIL_USER=your-sender-account@gmail.com

# OAuth2 credentials from Google Cloud Console
OAUTH_CLIENT_ID=xxxxxxxxxxxx.apps.googleusercontent.com
OAUTH_CLIENT_SECRET=GOCSPX-xxxxxxxxxxxx
OAUTH_REFRESH_TOKEN=1//xxxxxxxxxxxx

# Your real inbox — where you want to receive the messages
TO_EMAIL=your-real-inbox@gmail.com

# The URL of your portfolio (used for CORS). No trailing slash.
ALLOWED_ORIGIN=https://abichandani.github.io

# Render sets this automatically — leave it out locally and it defaults to 3000
# PORT=3000
