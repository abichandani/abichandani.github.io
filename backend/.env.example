# Gmail account you create specifically for sending portfolio contact emails
# Enable 2-Step Verification on this account, then generate an App Password at:
# https://myaccount.google.com/apppasswords
SMTP_USER=<sender-email>
SMTP_PASS=<password>

# Your real inbox — where you want to receive the messages
TO_EMAIL=<receiver-email>

# The URL of your portfolio (used for CORS). No trailing slash.
# Example: https://abichandani.github.io
ALLOWED_ORIGIN=https://abichandani.github.io

# Render sets this automatically — leave it out locally and it defaults to 3000
# PORT=3000
